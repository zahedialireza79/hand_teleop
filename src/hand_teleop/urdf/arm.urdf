<?xml version="1.0"?>
<robot name="hand_teleop_arm">

  <!-- ═══════════════════════════════════════════════════════
       MATERIALS
  ═══════════════════════════════════════════════════════ -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.5 1.0 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>


  <!-- ═══════════════════════════════════════════════════════
       LINKS
  ═══════════════════════════════════════════════════════ -->

  <!-- base_link: fixed to the ground (grey box) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035"/>            <!-- centre of box at half height -->
      <geometry>
        <box size="0.08 0.08 0.07"/>       <!-- 8x8x7 cm -->
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- link1: sits on base, rotates around Z (blue box) -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.05"/>             <!-- centre at half its height -->
      <geometry>
        <box size="0.05 0.04 0.10"/>       <!-- 5x4x10 cm -->
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- link2: upper arm (green box) -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.07"/>             <!-- centre at half its height -->
      <geometry>
        <box size="0.02 0.06 0.14"/>       <!-- 2x6x14 cm -->
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- link3: forearm (orange box) -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.07"/>             <!-- centre at half its height -->
      <geometry>
        <box size="0.02 0.06 0.14"/>       <!-- 2x6x14 cm -->
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- gripper_link: end effector (red box) -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0.045 0 0"/>            <!-- extend along X axis -->
      <geometry>
        <box size="0.09 0.03 0.05"/>       <!-- 9x3x5 cm -->
      </geometry>
      <material name="red"/>
    </visual>
  </link>


  <!-- ═══════════════════════════════════════════════════════
       JOINTS
  ═══════════════════════════════════════════════════════ -->

  <!-- Joint 1: base_link → link1
       Rotates around Z axis (turntable style)
       Positioned on top of base_link (height = 0.07m) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.07"/>              <!-- top of base -->
    <axis xyz="0 0 1"/>                   <!-- Z axis rotation -->
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Joint 2: link1 → link2
       Rotates around Y axis (shoulder forward/back)
       Positioned on top of link1 (height = 0.10m) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.10"/>              <!-- top of link1 -->
    <axis xyz="0 1 0"/>                   <!-- Y axis rotation -->
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Joint 3: link2 → link3
       Rotates around Y axis (elbow)
       Positioned on top of link2 (height = 0.14m) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.14"/>              <!-- top of link2 -->
    <axis xyz="0 1 0"/>                   <!-- Y axis rotation -->
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Joint 4: link3 → gripper_link
       Rotates around X axis (gripper open/close)
       Positioned on top of link3 (height = 0.14m) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.14"/>              <!-- top of link3 -->
    <axis xyz="1 0 0"/>                   <!-- X axis rotation -->
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0"/>
  </joint>

</robot>
